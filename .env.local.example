# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=994507786887

# Site URL
NEXT_PUBLIC_SITE_URL=https://cradexagency.com

# Revalidation Token (for Sanity webhook)
# Sent by the webhook as: Authorization: Bearer <token>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATION_TOKEN=your_64_character_hex_token_here

# Google Analytics 4
# Get from: analytics.google.com → Admin → Data Streams → your stream → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics Data API (Service Account)
# Get from: console.cloud.google.com → IAM → Service Accounts → Keys → JSON
GA_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GA_PROPERTY_ID=your_ga4_property_id
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
